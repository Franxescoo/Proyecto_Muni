# Configuración general
SECRET_KEY=clave_de_ejemplo

# Base de datos
DB_ENGINE=sqlite
DB_NAME=db.sqlite3

# Configuración opcional para MySQL
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Gmail SMTP para recuperación de contraseña.
# Usa una contraseña de aplicación de Google, nunca la contraseña normal.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-cuenta@gmail.com
EMAIL_HOST_PASSWORD=tu-contrasena-de-aplicacion
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=tu-cuenta@gmail.com

# Dominio público usado en los enlaces de recuperación.
# Local: 127.0.0.1:8000 | AWS: tu-dominio.cl
PASSWORD_RESET_DOMAIN=127.0.0.1:8000
PASSWORD_RESET_SITE_NAME=Municipalidad de La Serena
PASSWORD_RESET_USE_HTTPS=False

# AWS/producción: lista separada por comas, incluyendo el dominio público.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Ejemplo AWS: DJANGO_CSRF_TRUSTED_ORIGINS=https://tu-dominio.cl
DJANGO_BEHIND_PROXY=False
